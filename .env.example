# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- GitHub CMS & Owner Edit Mode (Server-Side Only, Configure in Vercel) ---
# GitHub Personal Access Token with Contents: Read & Write scope on this repo
GITHUB_TOKEN=""

# GitHub username or organization that owns the repository
GITHUB_OWNER=""

# GitHub repository name (e.g., hey-adhavan)
GITHUB_REPO=""

# Target branch to commit data.json updates to (defaults to main)
GITHUB_BRANCH="main"

# Secret Admin PIN required to unlock Owner Edit Mode and authorize GitHub commits
ADMIN_PIN="906"
